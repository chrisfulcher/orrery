Screen {
    layout: vertical;
}
#panels {
    layout: grid;
    grid-size: 3 3;
    grid-rows: 9 1fr 9;
    grid-gutter: 0 1;
    height: 1fr;
}
#work {
    column-span: 2;
}
#dates {
    column-span: 3;
}
.panel {
    border: round $primary;
    padding: 0 1;
    height: 100%;
}
Sparkline {
    height: 3;
}
#query {
    border: round $primary;
}
#hits {
    border: round $primary;
    height: 1fr;
}
#header, #pursuit, #incumbent, #summary, #officials, #entity_header, #pursuit_header,
#assessment {
    height: auto;
}
/* A large solicitation cites well over a hundred clauses (174 on the biggest notice in a
   real store), so this panel is bounded and scrolls rather than pushing the description off
   the screen; the count is on its border. */
#clauses_scroll {
    height: 5;
}
#description_scroll {
    height: 1fr;
}
#awards {
    height: 8;
}
#attachments {
    height: 7;
}
#entity_awards {
    height: 10;
}
#board, #radar, #entity_notices {
    height: 1fr;
}
#tasks {
    height: 1fr;
}
#pursuit_notices {
    height: 7;
}
#events {
    height: 9;
}
PromptModal, DecisionModal, TaskModal, PursueModal {
    align: center middle;
}
.modal_box {
    width: 72;
    height: auto;
    border: round $primary;
    background: $surface;
    padding: 0 1;
}
.modal_box ListView {
    height: auto;
    max-height: 8;
}
#setup_tabs {
    height: 1fr;
}
Form {
    height: 1fr;
    padding: 0 1;
}
Form Label.section {
    margin-top: 1;
    text-style: bold;
    color: $primary;
}
Form Label.field {
    margin-top: 1;
}
Form Input, Form Select {
    width: 1fr;
    max-width: 80;
}
Form TextArea {
    height: 6;
    max-width: 80;
}
.errors {
    color: $error;
    display: none;
}
.errors.-visible {
    display: block;
}
.locked {
    color: $text-muted;
}
.status {
    height: auto;
    border: round $primary;
    padding: 0 1;
}
.placeholder {
    padding: 1 2;
    color: $text-muted;
}
#setup_banner {
    display: none;
    border: round $warning;
    padding: 0 1;
    height: auto;
}
#setup_banner.-visible {
    display: block;
}
FormModal, ConfirmModal {
    align: center middle;
}
.modal_form {
    width: 78;
    height: 80%;
}
.modal_form Form {
    height: 1fr;
}
.modal_box TextArea {
    height: 8;
}
#stages, #searches {
    height: 1fr;
}
#operations {
    height: 1fr;
}
#job_log {
    height: 12;
    border: round $primary;
    padding: 0 1;
}
