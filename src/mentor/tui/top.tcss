Screen {
    layout: vertical;
}
#panels {
    layout: grid;
    grid-size: 3 3;
    grid-rows: 9 1fr 9;
    grid-gutter: 0 1;
    height: 1fr;
}
#work {
    column-span: 2;
}
#dates {
    column-span: 3;
}
.panel {
    border: round $primary;
    padding: 0 1;
    height: 100%;
}
Sparkline {
    height: 3;
}
#query {
    border: round $primary;
}
#header, #pursuit, #incumbent, #officials, #entity_header, #pursuit_header {
    height: auto;
}
#description_scroll {
    height: 1fr;
}
#awards {
    height: 8;
}
#attachments {
    height: 7;
}
#entity_awards {
    height: 10;
}
#board, #radar, #entity_notices {
    height: 1fr;
}
#tasks {
    height: 1fr;
}
#pursuit_notices {
    height: 7;
}
#events {
    height: 9;
}
PromptModal, DecisionModal, TaskModal, PursueModal {
    align: center middle;
}
.modal_box {
    width: 72;
    height: auto;
    border: round $primary;
    background: $surface;
    padding: 0 1;
}
.modal_box ListView {
    height: auto;
    max-height: 8;
}
