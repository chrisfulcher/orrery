# Settings, one MENTOR_<NAME> per line. `mentor top` writes this file from its Setup
# tab (5), so you need not copy or edit it by hand; to script it, copy this file to
# .env and fill it in. A blank value means "use the default"; real environment
# variables override this file, and the app shows such settings as locked.

# SAM.gov public API key. Needed by `ingest notices` and `fetch`; never logged.
MENTOR_SAM_API_KEY=

# Keyed SAM.gov requests (search pages and notice descriptions) allowed per UTC day.
# 10 fits a key with no SAM.gov role; a key with a role on an entity registration gets ~1000.
MENTOR_SAM_DAILY_BUDGET=10

# The only host the API key is ever sent to.
MENTOR_SAM_BASE_URL=https://api.sam.gov

# NAICS codes to ingest, comma-separated (for example 541512,541511). Needed by `ingest notices`.
MENTOR_NAICS=

# Directory for the database and downloaded attachments, relative to the working directory
# when running from source. The container ignores this and uses /data, which compose.yaml
# mounts from ./data.
MENTOR_DATA_DIR=data

# Seconds to pause between attachment downloads (politeness; attachments spend no quota).
MENTOR_FETCH_DELAY=1.0

# Attachments larger than this are recorded as skipped, not downloaded (100 MiB).
MENTOR_MAX_ATTACHMENT_BYTES=104857600

# USAspending API, used by `ingest awards`. No key and no quota; the finished file is served
# from files.usaspending.gov, a sibling host under the same domain.
MENTOR_USASPENDING_BASE_URL=https://api.usaspending.gov

# OpenAI-compatible embeddings endpoint, used by `embed` and `search --semantic`. The default
# is a local Ollama. From the container, a host Ollama is http://host.docker.internal:11434/v1.
MENTOR_EMBED_BASE_URL=http://localhost:11434/v1

# Embedding model name as the endpoint knows it (`ollama pull nomic-embed-text`).
MENTOR_EMBED_MODEL=nomic-embed-text

# Bearer token for the embeddings endpoint, if it needs one. Ollama does not.
MENTOR_EMBED_API_KEY=

# Texts per embeddings request.
MENTOR_EMBED_BATCH_SIZE=32

# Chat models, two slots (docs/DESIGN.md §4). The fast slot does grunt work; the deep slot
# does judgment such as `pursuit assess`. Provider `openai` is any OpenAI-compatible endpoint
# (Ollama, LM Studio, llama.cpp, vLLM, OpenAI, OpenRouter); `anthropic` uses the official SDK.
# The default is a local Ollama (`ollama pull qwen3:14b`); run it with a context of 16k
# tokens or more (OLLAMA_CONTEXT_LENGTH=16384) so long prompts are not truncated.
MENTOR_AI_FAST_PROVIDER=openai
MENTOR_AI_FAST_BASE_URL=http://localhost:11434/v1
MENTOR_AI_FAST_MODEL=qwen3:14b
MENTOR_AI_FAST_API_KEY=
MENTOR_AI_FAST_CONTEXT_CHARS=48000

# Leave the deep provider empty to use the fast slot for everything. With `anthropic`, the
# model defaults to claude-opus-5, requests use the official SDK, and the key may come from
# ANTHROPIC_API_KEY (or an `ant auth login` profile) instead of MENTOR_AI_DEEP_API_KEY.
MENTOR_AI_DEEP_PROVIDER=
MENTOR_AI_DEEP_BASE_URL=
MENTOR_AI_DEEP_MODEL=
MENTOR_AI_DEEP_API_KEY=
MENTOR_AI_DEEP_CONTEXT_CHARS=

# Seconds to wait for one model response; local models can take minutes.
MENTOR_AI_TIMEOUT=600
